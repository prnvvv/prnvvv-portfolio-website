# Copy to backend/.env and fill in. NEVER commit .env.

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1000
GROQ_TIMEOUT_SECONDS=20

# --- Vector database (ChromaDB) ---
# Embeddings are ChromaDB's built-in default (local ONNX all-MiniLM-L6-v2): no API key or token needed.
VECTOR_DB=chroma
# Where ChromaDB persists the collection (relative to backend/). On Render, point this at a mounted persistent disk.
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=portfolio_knowledge

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of the exact portfolio origins allowed to call the API (no wildcard).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prnvvv-portfolio-website.vercel.app
# Dev only: also allow http://localhost:<any port> and http://127.0.0.1:<any port> (set false in production).
ALLOW_LOCALHOST_ORIGINS=true
# Set true only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting).
TRUST_PROXY_HEADERS=false

# --- Retrieval / guardrails ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_INPUT_LENGTH=1000
MAX_CONTEXT_LENGTH=6000

# --- Abuse prevention ---
RATE_LIMIT_PER_MINUTE=20
SESSION_RATE_LIMIT_PER_MINUTE=12

# --- Admin (leave empty to disable POST /api/admin/ingest). Use a random value of 24+ characters. ---
ADMIN_TOKEN=

DEBUG=false
