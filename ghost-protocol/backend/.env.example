# Copy to backend/.env and fill in. NEVER commit .env.

# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=600
GROQ_TIMEOUT_SECONDS=20

# --- Embeddings / FAISS (local) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=vector_store/faiss.index
FAISS_METADATA_PATH=vector_store/metadata.json

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of the exact portfolio origins allowed to call the API (no wildcard).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prnvvv-portfolio-website.vercel.app
# Set true only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting).
TRUST_PROXY_HEADERS=false

# --- Retrieval / guardrails ---
TOP_K=5
SIMILARITY_THRESHOLD=0.25
MAX_INPUT_LENGTH=1000
MAX_CONTEXT_LENGTH=6000

# --- Abuse prevention ---
RATE_LIMIT_PER_MINUTE=20
SESSION_RATE_LIMIT_PER_MINUTE=12

# --- Admin (leave empty to disable POST /api/admin/ingest). Use a random value of 24+ characters. ---
ADMIN_TOKEN=

DEBUG=false
